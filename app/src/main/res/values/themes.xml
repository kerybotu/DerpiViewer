<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 应用主主题：无 ActionBar，使用 Material 3 设计 -->
    <style name="Theme.DerpiViewer" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 主要颜色，可自定义 -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- 状态栏透明或半透明，可选 -->
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
    </style>
    <style name="Theme.DerpiViewer.FullScreen" parent="Theme.DerpiViewer">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="BottomNavText" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
    </style>
</resources>
