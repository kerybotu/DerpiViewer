<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="?attr/colorSurface">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="深度 IP 优选" android:textSize="20sp" android:textStyle="bold" android:textColor="?attr/colorOnSurface" />
    <ScrollView android:id="@+id/deep_optimize_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp" android:background="?attr/colorSurfaceVariant">
        <TextView android:id="@+id/deep_optimize_log" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:fontFamily="monospace" android:textColor="?attr/colorOnSurface" android:textSize="12sp" />
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
        <Button android:id="@+id/deep_optimize_confirm_btn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="等待测速完成" />
        <Button android:id="@+id/deep_optimize_close_btn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="关闭" />
    </LinearLayout>
</LinearLayout>
