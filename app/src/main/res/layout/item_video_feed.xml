<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <FrameLayout
        android:id="@+id/video_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">
        <ImageView
            android:id="@+id/video_ambient_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.42"
            android:scaleType="centerCrop" />
        <View
            android:id="@+id/video_ambient_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <androidx.media3.ui.PlayerView
            android:id="@+id/video_player"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:keepScreenOn="true"
            app:resize_mode="fit"
            app:surface_type="texture_view" />
    </FrameLayout>

    <com.kerybotu.derpibooru.mirror.ui.IslandGlassView
        android:id="@+id/video_action_rail"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="16dp"
        android:paddingVertical="6dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageButton android:id="@+id/video_upvote" android:layout_width="44dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="点赞" android:padding="10dp" android:src="@drawable/ic_arrow_up" />
            <TextView android:id="@+id/video_upvote_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:textSize="11sp" android:textStyle="bold" />
            <ImageButton android:id="@+id/video_downvote" android:layout_width="44dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="踩" android:padding="10dp" android:src="@drawable/ic_arrow_down" />
            <View android:id="@+id/video_action_divider_primary" android:layout_width="28dp" android:layout_height="1dp" android:layout_marginVertical="6dp" />
            <ImageButton android:id="@+id/video_favorite" android:layout_width="44dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="收藏" android:padding="10dp" android:src="@drawable/ic_favorite" />
            <View android:id="@+id/video_action_divider_secondary" android:layout_width="28dp" android:layout_height="1dp" />
            <ImageButton android:id="@+id/video_comments" android:layout_width="44dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="评论" android:padding="10dp" android:src="@drawable/ic_comment" />
            <View android:id="@+id/video_action_divider_tertiary" android:layout_width="28dp" android:layout_height="1dp" />
            <ImageButton android:id="@+id/video_download" android:layout_width="44dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="下载" android:padding="10dp" android:src="@drawable/ic_download" />
            <ImageButton android:id="@+id/video_more" android:layout_width="44dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="更多" android:padding="10dp" android:src="@drawable/ic_more" />
        </LinearLayout>
    </com.kerybotu.derpibooru.mirror.ui.IslandGlassView>

    <com.kerybotu.derpibooru.mirror.ui.IslandGlassView
        android:id="@+id/video_info_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="20dp"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:id="@+id/video_uploader" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/video_tags" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="1" android:textSize="12sp" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="28dp" android:layout_marginTop="8dp">
                <ProgressBar android:id="@+id/video_buffer_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_gravity="center_vertical" android:indeterminate="false" android:max="1000" />
                <SeekBar android:id="@+id/video_play_progress" android:layout_width="match_parent" android:layout_height="28dp" android:max="1000" android:paddingStart="0dp" android:paddingEnd="0dp" android:contentDescription="视频播放进度" />
            </FrameLayout>
        </LinearLayout>
    </com.kerybotu.derpibooru.mirror.ui.IslandGlassView>

    <com.example.liquidglass.LiquidGlassView
        android:id="@+id/video_buffer_glass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone">
        <TextView android:id="@+id/video_buffer_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="10dp" android:paddingVertical="5dp" android:textSize="11sp" />
    </com.example.liquidglass.LiquidGlassView>
    <com.example.liquidglass.LiquidGlassView
        android:id="@+id/video_speed_glass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone">
        <TextView android:id="@+id/video_speed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="14dp" android:paddingVertical="8dp" android:text="2x" android:textStyle="bold" />
    </com.example.liquidglass.LiquidGlassView>
</FrameLayout>
