<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.kerybotu.derpibooru.mirror.ui.VideoGlassBackdrop
        android:id="@+id/video_glass_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/video_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.kerybotu.derpibooru.mirror.ui.IslandGlassView
        android:id="@+id/video_top_island"
        android:layout_width="180dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="6dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/video_menu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="打开菜单"
                android:padding="12dp"
                android:src="@drawable/ic_menu" />
            <ImageButton
                android:id="@+id/video_audio"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="静音"
                android:padding="12dp"
                android:src="@drawable/ic_volume" />
            <ImageButton
                android:id="@+id/video_sort"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="切换排序"
                android:padding="12dp"
                android:src="@drawable/ic_more" />
        </LinearLayout>
    </com.kerybotu.derpibooru.mirror.ui.IslandGlassView>

    <com.example.liquidglass.LiquidGlassView
        android:id="@+id/video_empty_glass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone">
        <TextView
            android:id="@+id/video_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="20dp"
            android:text="正在加载视频…"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />
    </com.example.liquidglass.LiquidGlassView>
</FrameLayout>
